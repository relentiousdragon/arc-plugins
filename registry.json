      "license": "MIT",
      "tags": [],
      "arcApiVersion": 1,
      "minArcStudioVersion": "2026.1.1-alpha.6",
      "commit": "093606fc94ed6b4cb2c94316105bdd3b804e77df",
      "path": "adapters/resvg/arc-plugin.json",
      "sha256": "09ab038d80f372cded3f249b440a470ee16b119fff067abfd1a079b8271b726f",
      "wasmSha256": "1995f204f34087fabe52d40242719f9c67c15022c49eb76fc236dfeb06f4625b",
      "nodeTypes": [
        "arc.resvg.render-svg"
      ],
